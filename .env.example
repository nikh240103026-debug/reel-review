# ---------------------------------------------------------------------------
# ReelReview configuration. Copy to .env.local (or run `npm run setup`, which
# generates the secrets for you). Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL of the app. Review links and signed local-storage URLs use it.
# Use https:// in production (enables Secure cookies).
APP_URL=http://localhost:3000

# 32+ random characters. Signs editor sessions and local storage URLs and
# encrypts stored review-link tokens. Rotating it invalidates review links.
APP_SECRET=

# 16+ characters. The private key editors type on /unlock. Clients never use it.
# Rotating it signs out every editor session.
EDITOR_ACCESS_KEY=
EDITOR_DISPLAY_NAME=Editor

# --- Database ---------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the pooler (port 6543) or direct (5432) URL. Server-side only.
# Leave unset for LOCAL DEVELOPMENT MODE (embedded PGlite in .data/pglite).
DATABASE_URL=
DATABASE_POOL_MAX=5
# PGLITE_DATA_DIR=.data/pglite

# --- Object storage (Cloudflare R2 or any S3-compatible bucket) --------------
# Leave unset for LOCAL DEVELOPMENT MODE (files in .data/storage, served via
# HMAC-signed URLs). The bucket must be PRIVATE (no public access).
R2_ACCOUNT_ID=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional overrides for non-R2 providers:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
# STORAGE_DRIVER=s3|local   (auto-detected)
SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_GB=20

# --- Claude -----------------------------------------------------------------
# Without a key, AI Review offers only a clearly labelled offline draft (no AI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=high

# --- Optional server media tools --------------------------------------------
# If ffprobe/ffmpeg exist on the server, uploads are probed (fps, codecs) and
# Claude receives stills at comment timestamps. Not required.
# FFPROBE_PATH=/usr/bin/ffprobe
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- Jobs -------------------------------------------------------------------
JOB_LEASE_SECONDS=120
LOG_LEVEL=info
